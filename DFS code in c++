#include <iostream>
#include <vector>
using namespace std;

void DFS(int node, vector<int> adj[], vector<bool>& visited) {
    visited[node] = true;
    cout << node << " ";

    for (int next : adj[node]) {
        if (!visited[next]) {
            DFS(next, adj, visited);
        }
    }
}

int main() {
    int n = 6;
    vector<int> adj[n];

    adj[0].push_back(1);
    adj[0].push_back(2);
    adj[1].push_back(3);
    adj[1].push_back(4);
    adj[2].push_back(5);

    vector<bool> visited(n, false);

    cout << "DFS Traversal: ";
    DFS(0, adj, visited);

    return 0;
}
